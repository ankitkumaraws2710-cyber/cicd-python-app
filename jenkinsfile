pipeline {
    agent any

    environment {
        IMAGE_NAME = 'python-ci-cd-app'
        CONTAINER_NAME = 'python-ci-cd-container'
        APP_PORT = '5000'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Starting CI/CD pipeline'
                echo 'Source code is available in the Jenkins workspace'
                sh 'ls -la'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image'

                sh '''
                    docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                    docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing Python application'

                sh '''
                    docker run --rm \
                        --entrypoint python \
                        ${IMAGE_NAME}:${BUILD_NUMBER} \
                        -m py_compile /app/test.py
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                echo 'Deploying application container'

                sh '''
                    docker rm -f ${CONTAINER_NAME} || true

                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:${APP_PORT} \
                        ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Health Check') {
            steps {
                echo 'Checking application health'

                sh '''
                    for i in $(seq 1 15); do
                        if curl -fsS http://127.0.0.1:${APP_PORT}/; then
                            echo "Application health check passed"
                            exit 0
                        fi

                        sleep 2
                    done

                    echo "Application health check failed"
                    docker logs ${CONTAINER_NAME}
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Build, test, deployment and health check completed.'
        }

        failure {
            echo 'FAILURE: Check the failed stage and Jenkins console output.'
        }

        always {
            echo 'CI/CD pipeline execution finished.'
        }
    }
}
